# build output - regenerated by build.py, never committed
dist/

# Map build artifacts. Regenerated by overlay.py from committed inputs
# (maps.json, markers.py, places.json, tilemeta.json), so they are not
# tracked. The committed inputs are, because rebuilding those means
# re-hitting rate-limited Esri/Wikidata/OSM.
destinations/*/maps/gmap_*.html
destinations/*/maps/savedlist.html
destinations/*/maps/.resolve-cache.json
destinations/*/maps/.routes-cache.json
destinations/*/maps/.placeid-cache.json
destinations/*/maps/.placement.json

# Review surface for tools/kml.py, regenerated from places.json on demand.
# routes.json IS tracked - it holds fetched OSRM geometry.
destinations/*/maps/places.kml

# Local safety net: maps.py copies guide.html here before rewriting it in
# place, keeping the last 10. Recovery is a plain cp. Never committed.
destinations/*/.guide-history/

# API keys never belong in this repo - it is published to GitHub Pages.
# routes.py reads ORS_API_KEY from the environment; nothing needs a key file.
.env
.env.*
*.key
secrets.json

# local agent/session state, not project source
.claude/

.DS_Store
__pycache__/

.tmp/
destinations/*/maps/tripmap.kml
